#!/usr/bin/env bash
# 在受保护分支上直接 commit 时运行 CI 检查。
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=ci_protected_branches.sh
source "$ROOT/scripts/ci_protected_branches.sh"

BRANCH="$(git branch --show-current 2>/dev/null || true)"

if ! ci_is_protected_branch "$BRANCH"; then
  exit 0
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Git Hook：在「${BRANCH}」上提交，运行 CI 检查"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

if ! "$ROOT/scripts/ci_check.sh"; then
  echo ""
  echo "❌ CI 检查失败，已阻止 commit。" >&2
  echo "   修复问题后重新提交，或使用：git commit --no-verify" >&2
  exit 1
fi
