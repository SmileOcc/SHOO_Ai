#!/usr/bin/env bash
# push 到受保护远程分支前运行 CI 检查。
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=ci_protected_branches.sh
source "$ROOT/scripts/ci_protected_branches.sh"

TARGET=""
while read -r local_ref local_sha remote_ref remote_sha; do
  branch="$(ci_protected_branch_from_remote_ref "$remote_ref" || true)"
  if [[ -n "$branch" ]]; then
    TARGET="$branch"
    break
  fi
done

if [[ -z "$TARGET" ]]; then
  exit 0
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Git Hook：即将 push 到 origin/${TARGET}，运行 CI 检查"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

if ! "$ROOT/scripts/ci_check.sh"; then
  echo ""
  echo "❌ CI 检查失败，已阻止 push 到 ${TARGET}。" >&2
  echo "   修复问题后重新 push，或使用：git push --no-verify" >&2
  exit 1
fi
