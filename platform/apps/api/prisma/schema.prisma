generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  phone        String?
  nickname     String
  avatarUrl    String?
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orders       Order[]
  userCoupons  UserCoupon[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("super_admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  link      String
  title     String
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Full category tree document returned by GET /categories
model CategoryTree {
  id        String   @id @default("default")
  payload   Json
  updatedAt DateTime @updatedAt
}

model Product {
  id             String   @id
  categoryId     String   @default("")
  title          String
  imageUrl       String
  price          Int
  originalPrice  Int
  discountLabel  String   @default("")
  rating         Float    @default(0)
  soldCount      Int      @default(0)
  description    String   @default("")
  images         Json     @default("[]")
  reviewCount    Int      @default(0)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([categoryId])
  @@index([enabled])
}

model Order {
  id              String      @id @default(cuid())
  orderNo         String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  status          String
  totalCents      Int
  shippingAddress String      @default("")
  hasLogistics    Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  title        String
  imageUrl     String
  price        Int
  quantity     Int
  variantLabel String @default("")
}

/// JSON documents synced from `assets/mock/*.json` for App API parity.
model AppDocument {
  key       String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

model FlashSaleFollow {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  title     String   @default("")
  imageUrl  String   @default("")
  createdAt DateTime @default(now())

  @@unique([sessionId, productId])
  @@index([sessionId])
}

model AfterSale {
  id           String   @id @default(cuid())
  orderId      String
  orderNo      String   @default("")
  type         String
  status       String   @default("pending")
  reason       String   @default("")
  productTitle String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Coupon template — wallet, theme activity, flash-sale share the same id space.
model CouponTemplate {
  id              String       @id
  title           String
  description     String       @default("")
  type            String       @default("fixed") // fixed | percent
  discountCents   Int          @default(0)
  discountPercent Int          @default(0)
  minOrderCents   Int          @default(0)
  validDays       Int          @default(30)
  stock           Int?
  claimedCount    Int          @default(0)
  enabled         Boolean      @default(true)
  source          String       @default("wallet") // wallet | theme | flash
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  userCoupons     UserCoupon[]
}

model UserCoupon {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  template   CouponTemplate @relation(fields: [templateId], references: [id])
  claimedAt  DateTime       @default(now())
  expiresAt  DateTime
  isUsed     Boolean        @default(false)

  @@unique([userId, templateId])
  @@index([userId])
}

/// ThemeActivity page config CMS (see docs/Flutter主题活动ThemeActivity技术方案.md)
model ThemeActivity {
  /// Same as config.activityId — Deep Link /theme-activity/{activityId}
  activityId      String    @id
  title           String
  status          String    @default("draft") // draft | online | offline
  startAt         DateTime?
  endAt           DateTime?
  expiredBehavior String    @default("browse") // block | browse
  /// Full page JSON (navBar, modules, footer, defaultStyle, …)
  config          Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}
